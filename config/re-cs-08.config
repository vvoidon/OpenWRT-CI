# 仅构建京东云 RE-CS-08
CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq53xx=y
CONFIG_TARGET_DEVICE_qualcommbe_ipq53xx_DEVICE_jdcloud_re-cs-08=y

# 生成本平台 target packages 与常用内核模块仓库；可选硬件由 prune_packages.py 排除。
CONFIG_ALL_NONSHARED=y

# 有线设备不预装 IPQ5332/QCN9274 无线固件及 relayd/luci-proto-relay。
# 由 prune_packages.py 按依赖排除；若保留功能依赖它们，则自动保留。

# RTPengine 的内核模块当前无法编译；排除整个包的所有变体。
# CONFIG_PACKAGE_kmod-ipt-rtpengine is not set
# CONFIG_PACKAGE_iptables-mod-rtpengine is not set
# CONFIG_PACKAGE_rtpengine is not set
# CONFIG_PACKAGE_rtpengine-no-transcode is not set
# CONFIG_PACKAGE_rtpengine-recording is not set
