# RE-CS-08 uses IPQ5332 M31/UNIPHY PHYs, not these other-SoC QMP/QUSB2 drivers.
# Keep its Ethernet, SFP, eMMC, thermal, USB-HS and UNIPHY-PCIe support intact.
# CONFIG_PHY_QCOM_QMP is not set
# CONFIG_PHY_QCOM_QMP_COMBO is not set
# CONFIG_PHY_QCOM_QMP_PCIE is not set
# CONFIG_PHY_QCOM_QMP_PCIE_8996 is not set
# CONFIG_PHY_QCOM_QMP_UFS is not set
# CONFIG_PHY_QCOM_QMP_USB is not set
# CONFIG_PHY_QCOM_QMP_USB_LEGACY is not set
# CONFIG_PHY_QCOM_QUSB2 is not set

# This eMMC board has no parallel NOR or raw/SPI NAND controller in its active
# device tree. Keep the MTD framework and SPI NOR support for diagnostic tools.
# CONFIG_MTD_CFI is not set
# CONFIG_MTD_RAW_NAND is not set
# CONFIG_MTD_NAND_QCOM is not set
# CONFIG_MTD_SPI_NAND is not set
